# Database (Neon / PostgreSQL)
# Jangan pernah menaruh kredensial asli di file contoh yang ikut di-commit.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth.js (opsional; bukan dipakai API Express)
NEXTAUTH_SECRET="ganti-dengan-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# API Express / serverless
JWT_SECRET="ganti-dengan-openssl-rand-hex-32"
# Aktif selama admin memakai portal; cookie diperpanjang setiap /auth/me.
SESSION_DAYS="30"
# same-origin (Netlify proxy): lax. Untuk frontend & API beda situs: none (wajib HTTPS).
COOKIE_SAMESITE="lax"
# auto | true | false
COOKIE_SECURE="auto"
ALLOWED_ORIGINS="http://localhost:5500,http://localhost:3000"
ADMIN_USER="admin"
ADMIN_PASS="ganti-dengan-sandi-kuat"
SEED_TOKEN=""

# Cloudflare R2 (opsional)
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# App
NODE_ENV="development"
