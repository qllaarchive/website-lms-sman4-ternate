# Server
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
JWT_SECRET="change-me-with-openssl-rand-hex-32"
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:5500,http://localhost:3000"

# Sesi admin
SESSION_DAYS="30"
COOKIE_SAMESITE="lax"
COOKIE_SECURE="auto"

# Admin seed (used by `npm run seed`)
ADMIN_USER="admin"
ADMIN_PASS="ganti-dengan-sandi-kuat"
# Opsional: izinkan reset kata sandi admin lewat POST /api/seed (header X-Seed-Token)
SEED_TOKEN=""
