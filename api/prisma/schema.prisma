generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  role          String   @default("ADMIN")
  createdAt     DateTime @default(now())
}

model LmsEntry {
  id        String   @id
  klass     String
  name      String
  short     String
  teacher   String?
  icon      String
  color     String
  file      String
  pub       Boolean  @default(true)
  scriptId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([klass])
}

model Slider {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  sortOrder Int      @default(0)
  pub       Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolProfile {
  id        String   @id @default("default")
  name      String
  npsn      String   @default("")
  addr      String   @default("")
  telp      String   @default("")
  email     String   @default("")
  ppdb      String   @default("")
  updatedAt DateTime @updatedAt
}
