generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  role          String    @default("ADMIN")
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LmsEntry {
  id        String   @id @default(cuid())
  klass     String
  name      String
  short     String?
  teacher   String?
  icon      String
  color     String
  file      String
  pub       Boolean  @default(true)
  scriptId  String?
  createdAt DateTime @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([klass])
}

model Slider {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  sortOrder Int      @default(0)
  pub       Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

model SchoolProfile {
  id        String   @id @default("default")
  name      String
  npsn      String   @default("")
  addr      String   @default("")
  telp      String   @default("")
  email     String   @default("")
  ppdb      String   @default("")
  updatedAt     DateTime  @default(now()) @updatedAt
}
